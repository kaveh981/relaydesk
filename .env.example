# Reference configuration. npm run dev does not automatically read this file.
# These are public, local-demo values. Do not expose them to the Internet.
HOST=127.0.0.1
PORT=3000
DEMO_MODE=true
DATABASE_PATH=data/relaydesk.sqlite
ADMIN_API_KEY=sample-admin-key-change-me
WEBHOOK_SECRET=sample-webhook-secret-change-me
DELIVERY_SECRET=sample-delivery-secret-change-me

# With DEMO_MODE=false, explicitly set all three independent secrets above
# and set a fixed HTTPS receiver URL. No event may choose its destination.
# DELIVERY_URL=https://your-authorized-receiver.example/webhooks

# Delivery budget and worker timing, in milliseconds where named.
MAX_ATTEMPTS=4
RETRY_BASE_MS=1000
RETRY_MAX_MS=30000
DELIVERY_TIMEOUT_MS=3000
WORKER_LEASE_MS=10000
